{
    "$schema": "https://json.schemastore.org/claude-code-settings.json",
    "enabledPlugins": {
        "context7@claude-plugins-official": true,
        "code-review@claude-plugins-official": true
    },
    "sandbox": {
        "enabled": true,
        "allowUnsandboxedCommands": false,
        "autoAllowBashIfSandboxed": false,
        "network": {
            "allowedDomains": [
                "github.com",
                "raw.githubusercontent.com"
            ]
        },
        "filesystem": {
            "denyWrite": [
                "**/.env*",
                "**/secrets/**",
                "**/*secret*",
                "**/*credential*",
                "**/*token*",
                "**/*APIKey*",
                "**/*apikey*",
                "**/*.p12",
                "**/*.p8",
                "**/*.cer",
                "**/*.pem",
                "**/*.key",
                "**/*.gpg",
                "**/*.asc",
                "**/*.keystore",
                "**/*.jks",
                "**/.netrc",
                "**/.npmrc",
                "**/.pypirc",
                "**/build/**",
                "**/.claude/settings.json",
                "**/.claude/settings.local.json"
            ],
            "denyRead": [
                "**/.env*",
                "**/secrets/**",
                "**/*secret*",
                "**/*credential*",
                "**/*token*",
                "**/*APIKey*",
                "**/*apikey*",
                "**/*.p12",
                "**/*.p8",
                "**/*.cer",
                "**/*.pem",
                "**/*.key",
                "**/*.gpg",
                "**/*.asc",
                "**/*.keystore",
                "**/*.jks",
                "**/.netrc",
                "**/.npmrc",
                "**/.pypirc",
                "**/build/**",
                "**/.DS_Store",
                "**/.idea/**",
                "**/*.log",
                "~/.ssh/**",
                "~/.aws/**",
                "~/.gcp/**",
                "~/.config/gh/**",
                "~/.netrc",
                "~/.npmrc",
                "~/.docker/config.json",
                "~/.zsh_history",
                "~/.bash_history",
                "~/Library/Keychains/**",
                "~/.gnupg/**",
                "/etc/passwd",
                "/etc/shadow"
            ]
        },
        "excludedCommands": [
            "git status",
            "git diff *",
            "git push *",
            "git pull *",
            "git fetch *",
            "git branch *",
            "git checkout *",
            "git commit *",
            "git reset *",
            "git add *"
        ]
    },
    "env": {
        "CLAUDE_BASH_MAINTAIN_PROJECT_WORKING_DIR": "1",
        "DISABLE_FEEDBACK_COMMAND": "1",
        "DISABLE_ERROR_REPORTING": "1"
    },
